# Read at build time by webpack.config.js (DefinePlugin) and injected into the bundle.
# Export them in your shell or in CI before running "pnpm build".

# Where the orchestrator backend lives, including the /api suffix.
MFE_BACKEND_URL=https://console.mfe-orchestrator.dev/api

# Id of your project in the orchestrator.
MFE_PROJECT_ID=

# Environment slug, ex. DEV / STAGE / PROD. OPTIONAL: leave it empty or delete the
# line and the backend picks the environment from the domain the request comes from.
MFE_ENVIRONMENT=DEV
